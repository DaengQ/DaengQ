<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 댕큐 디자인 시스템 테마. 다크 모드는 지원하지 않고 차가 야간 모드여도 밝은 화면을 쓴다 -->
    <style name="Theme.Pawgo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_active</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:textColorPrimary">@color/fg_strong</item>
        <item name="android:textColorSecondary">@color/fg_muted</item>
        <item name="android:fontFamily">@font/asta_sans</item>
        <item name="fontFamily">@font/asta_sans</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
        글자 스타일. 크기는 IVI 1700×1184 디자인 기준 px이고, Pleos Connect 화면 밀도(160)에서는 1px = 1dp다.
        운전 중 읽는 화면이라 Caption(20)보다 작은 글자는 쓰지 않는다.
    -->
    <style name="Text.Daengq" parent="">
        <item name="android:fontFamily">@font/asta_sans</item>
        <item name="android:textColor">@color/fg_body</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Daengq.Display">
        <item name="android:textSize">96sp</item>
        <item name="android:lineHeight">120sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/fg_strong</item>
    </style>

    <style name="Text.Daengq.H2">
        <item name="android:textSize">48sp</item>
        <item name="android:lineHeight">62sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/fg_strong</item>
    </style>

    <style name="Text.Daengq.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:lineHeight">44sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/fg_strong</item>
    </style>

    <style name="Text.Daengq.Label">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">36sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/fg_strong</item>
    </style>

    <style name="Text.Daengq.Body">
        <item name="android:textSize">24sp</item>
        <item name="android:lineHeight">34sp</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="Text.Daengq.Caption">
        <item name="android:textSize">20sp</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/fg_muted</item>
    </style>

    <!-- 버튼 -->
    <style name="Button.Daengq" parent="Text.Daengq.Label">
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:maxLines">2</item>
    </style>

    <!-- 주요 버튼: 브랜드 초록 배경 + 흰 글자 -->
    <style name="Button.Daengq.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_button_primary</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- 보조 버튼: 표면 배경 + 컨트롤 테두리 -->
    <style name="Button.Daengq.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_button_secondary</item>
    </style>

    <!-- 선택 버튼: 선택되면 연한 브랜드 배경 + 브랜드 테두리 -->
    <style name="Button.Daengq.Choice">
        <item name="android:background">@drawable/bg_button_choice</item>
        <item name="android:textColor">@color/text_button_choice</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- 주행 시작·종료 버튼: 가장 진한 글자색 배경 + 표면색 글자 -->
    <style name="Button.Daengq.Strong">
        <item name="android:background">@drawable/bg_button_strong</item>
        <item name="android:textColor">@color/bg_surface</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 시작 화면 제목. 디자인 시스템 Display(96) 크기에 가운데 정렬. 강조할 이름만 코드에서 색을 바꾼다 -->
    <style name="Text.Daengq.Hero" parent="Text.Daengq.Display">
        <item name="android:gravity">center</item>
    </style>

    <!-- 시작 화면 버튼. 글자는 디자인 시스템 H3(40) 크기에 굵기 700 -->
    <style name="Button.Daengq.Hero" parent="Button.Daengq">
        <item name="android:textSize">40sp</item>
        <item name="android:lineHeight">52sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Button.Daengq.Hero.Dog">
        <item name="android:background">@drawable/bg_button_dog</item>
        <item name="android:textColor">@color/button_dog_text</item>
    </style>

    <style name="Button.Daengq.Hero.Add">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="Button.Daengq.Hero.Neutral">
        <item name="android:background">@drawable/bg_button_neutral</item>
        <item name="android:textColor">@color/fg_strong</item>
    </style>
</resources>
