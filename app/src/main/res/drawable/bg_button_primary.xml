<?xml version="1.0" encoding="utf-8"?>
<!-- 주요 버튼. 누르면 brand_primary_active로 진해진다 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/bg_sub" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/brand_primary_active" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/brand_primary" /><corners android:radius="16dp" /></shape>
    </item>
</selector>
