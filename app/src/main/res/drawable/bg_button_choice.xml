<?xml version="1.0" encoding="utf-8"?>
<!-- 기록 종류 선택 버튼. 지금 종류는 브랜드 색으로 표시한다 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/brand_bg_subtle" />
            <stroke android:width="2dp" android:color="@color/brand_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/bg_sub" />
            <stroke android:width="2dp" android:color="@color/border_control" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/bg_surface" />
            <stroke android:width="2dp" android:color="@color/border_control" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
