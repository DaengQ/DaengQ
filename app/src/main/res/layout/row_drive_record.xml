<?xml version="1.0" encoding="utf-8"?>
<!-- 주행 화면의 기록 한 줄: 시각, 종류 색 점, 종류, 남긴 방법(소리 감지·직접 기록) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/time"
        style="@style/Text.Daengq.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/fg_muted"
        android:textSize="26sp" />

    <View
        android:id="@+id/dot"
        android:layout_width="@dimen/dot_size"
        android:layout_height="@dimen/dot_size"
        android:layout_marginStart="36dp"
        android:background="@drawable/dot" />

    <TextView
        android:id="@+id/label"
        style="@style/Text.Daengq.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:textFontWeight="700"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/source"
        style="@style/Text.Daengq.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/fg_muted" />
</LinearLayout>
