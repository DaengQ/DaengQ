<?xml version="1.0" encoding="utf-8"?>
<!--
    주행 화면에서 지도 위에 뜬 기록 패널. 제목, 종류별 횟수, 최근 기록 고치기, 지난 기록, 주행 종료.
    주행 종료(시작) 버튼은 스크롤과 상관없이 항상 아래에 보인다.
    주행 중에는 한 번 눌러 끝나는 버튼만 두고, 깜빡이거나 움직이는 요소는 쓰지 않는다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_drive_panel"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/driveTitle"
        style="@style/Text.Daengq.H2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/soundStatus"
        style="@style/Text.Daengq.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sound_off"
        android:textColor="@color/fg_muted"
        android:textSize="28sp"
        android:lineHeight="38sp" />

    <!-- 위치 연결 실패, 음성 오류처럼 알아야 할 때만 보인다 -->
    <TextView
        android:id="@+id/driveAlert"
        style="@style/Text.Daengq.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- 종류별 횟수. 코드에서 세 칸과 사이 구분선을 채운다. 칸을 누르면 그 종류를 기록한다 -->
    <LinearLayout
        android:id="@+id/driveCounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="36dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 최근 기록: 종류 바꾸기·삭제를 한 번 눌러 끝낸다 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_drive_card"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/Text.Daengq.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/latest_record_title"
                    android:textColor="@color/fg_muted"
                    android:textFontWeight="600" />

                <include
                    android:id="@+id/latestRecord"
                    layout="@layout/row_drive_record"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/latestRecordEmpty"
                    style="@style/Text.Daengq.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/latest_record_empty"
                    android:textColor="@color/fg_muted" />

                <LinearLayout
                    android:id="@+id/latestRecordActions"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 지난 기록(최근 기록 다음부터 최신순) -->
            <LinearLayout
                android:id="@+id/olderRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_drive_card"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/tripButton"
        style="@style/Button.Daengq.Strong"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="24dp"
        android:text="@string/action_start_trip" />
</LinearLayout>
