<?xml version="1.0" encoding="utf-8"?>
<!-- 결과 화면 한 줄 요약(요약.svg): 마스코트 뒤에서 시작하는 꼬리표. 배경은 코드에서 TagDrawable로 입힌다.
     꼬리 끝이 높이에 비례해 커지므로 높이는 고정하고, 긴 문장은 줄바꿈 대신 글자를 줄여 한 줄에 담는다 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tagText"
        style="@style/Text.Daengq.Body"
        android:layout_width="match_parent"
        android:layout_height="@dimen/highlight_height"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/highlight_mascot_overlap"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="@dimen/highlight_text_start"
        android:paddingEnd="40dp"
        android:textColor="@color/fg_muted" />

    <ImageView
        android:layout_width="@dimen/highlight_mascot_width"
        android:layout_height="@dimen/highlight_height"
        android:layout_gravity="start|center_vertical"
        android:importantForAccessibility="no"
        android:src="@drawable/mascot_tag" />
</FrameLayout>
